[53.468247, "o", "\r\n\r\n\u001b[1m\u001b[1;36m┌──────────────────────────────────────────────────────────────────────┐\u001b[0m\r\n\u001b[1m\u001b[1;36m│  STEP 2 — Build 3-pod topology (network namespaces on a bridge)      │\u001b[0m\r\n\u001b[1m\u001b[1;36m└──────────────────────────────────────────────────────────────────────┘\u001b[0m\r\n\r\n"]
[55.470539, "o", "\r\n\u001b[2m  # We simulate Kubernetes pod networking using Linux network namespaces\u001b[0m\r\n\r\n"]
[57.672217, "o", "\u001b[2m"]
[57.673466, "o", "\r\n    ns_allowed  (10.244.0.10)  ─── vh_allowed ─┐\r\n                                                 ├─ br0 (10.244.0.1)  ── FORWARD ── iptables\r\n    ns_blocked  (10.244.0.20)  ─── vh_blocked ─┤        (host)\r\n    (ATTACKER)                                   │\r\n    ns_target   (10.244.0.30)  ─── vh_target  ─┘\r\n\r\n"]
[57.673661, "o", "\u001b[0m"]
[60.675412, "o", "\r\n\u001b[2m  # Create the bridge (simulates the pod overlay network)\u001b[0m\r\n\r\n"]
