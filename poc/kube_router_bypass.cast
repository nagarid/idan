[268.671474, "o", "\r\n\r\n\u001b[1m\u001b[1;36m┌──────────────────────────────────────────────────────────────────────┐\u001b[0m\r\n\u001b[1m\u001b[1;36m│  STEP 6 — iptables counters: forensic proof of the bypass            │\u001b[0m\r\n\u001b[1m\u001b[1;36m└──────────────────────────────────────────────────────────────────────┘\u001b[0m\r\n\r\n"]
[270.673417, "o", "\r\n\u001b[2m  # KUBE-NWPLCY should show 2 MARK hits: 1 legitimate + 1 spoofed\u001b[0m\r\n\r\n"]
[272.87511, "o", "\r\n\u001b[2m  # If the counter is 2, kube-router treated the spoofed packet as allowed.\u001b[0m\r\n\r\n"]
[275.076756, "o", "\u001b[1;32mroot@pod-attacker\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m#\u001b[0m i"]
