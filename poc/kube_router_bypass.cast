[196.14213, "o", "\r\n\r\n\u001b[1m\u001b[1;36m┌──────────────────────────────────────────────────────────────────────┐\u001b[0m\r\n\u001b[1m\u001b[1;36m│  STEP 4 — Baseline: verify NetworkPolicy works for normal traffic    │\u001b[0m\r\n"]
