[117.47085, "o", "\r\n\r\n\u001b[1m\u001b[1;36m┌──────────────────────────────────────────────────────────────────────┐\u001b[0m\r\n\u001b[1m\u001b[1;36m│  STEP 3 — Configure kube-router iptables chain hierarchy             │\u001b[0m\r\n\u001b[1m\u001b[1;36m└──────────────────────────────────────────────────────────────────────┘\u001b[0m\r\n\r\n"]
[119.472631, "o", "\r\n\u001b[2m  # kube-router programs iptables with this exact structure:\u001b[0m\r\n\r\n"]
[121.674423, "o", "\u001b[2m"]
[121.675787, "o", "\r\n  FORWARD\r\n    └─ KUBE-ROUTER-FORWARD       (-d <target> → jump to pod firewall)\r\n         └─ KUBE-POD-FW-<hash>\r\n              ├─ KUBE-NWPLCY-<hash>                    (evaluate policy)\r\n              ├─ -m mark --mark 0x10000  -j ACCEPT      (policy matched → allow)\r\n              └─ -j DROP                                 (default deny)\r\n\r\n  KUBE-NWPLCY-<hash>:\r\n    -m set --match-set KUBE-SRC-<hash> src  ← SOURCE IP ONLY — no interface check ⚠\r\n\r\n"]
[121.675916, "o", "\u001b[0m"]
[125.677755, "o", "\r\n\u001b[2m  # Create the three kube-router chains\u001b[0m\r\n\r\n"]
