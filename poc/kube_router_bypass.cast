[79.246495, "o", "\r\n\u001b[2m  # Helper script: creates one pod (netns + veth pair attached to bridge)\u001b[0m\r\n\r\n"]
[81.448204, "o", "\u001b[1;32mroot@pod-attacker\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m#\u001b[0m c"]
