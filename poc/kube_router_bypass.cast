[0.039496, "o", "\u001b[H\u001b[J\u001b[3J"]
[1.04107, "o", "\u001b[1;31m\u001b[1m"]
[1.042229, "o", "\r\n  ╔══════════════════════════════════════════════════════════════════════════╗\r\n  ║                                                                          ║\r\n  ║   kube-router / k3s  —  NetworkPolicy Bypass                            ║\r\n  ║   CVE Candidate: CAP_NET_RAW Source IP Spoofing                         ║\r\n  ║                                                                          ║\r\n  ║   Capability required : CAP_NET_RAW  ← present in EVERY default pod    ║\r\n  ║   Privileged pod      : NO                                               ║\r\n  ║   Affected            : kube-router (all), k3s (all)                    ║\r\n  ║                                                                          ║\r\n  ║   A blocked pod can bypass NetworkPolicy and reach a denied target       ║\r\n  ║   by spoofing the source IP of an allowed pod in a raw socket.          ║\r\n  ║                                                                          ║\r\n  ╚══════════════════════════════════════════════════════════════════════════╝\r\n\r\n"]
[1.042776, "o", "\u001b[0m"]
[5.044006, "o", "\r\n\r\n\u001b[1m\u001b[1;36m┌──────────────────────────────────────────────────────────────────────┐\u001b[0m\r\n\u001b[1m\u001b[1;36m│  STEP 1 — Confirm we are inside a default (unprivileged) pod         │\u001b[0m\r\n\u001b[1m\u001b[1;36m└──────────────────────────────────────────────────────────────────────┘\u001b[0m\r\n\r\n"]
[7.046003, "o", "\r\n\u001b[2m  # Check who we are. No root on the host — just inside a container.\u001b[0m\r\n\r\n"]
[9.2478, "o", "\u001b[1;32mroot@pod-attacker\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m#\u001b[0m i"]
[9.319406, "o", "d"]
[10.0722, "o", "\r\n"]
[10.073814, "o", "uid=0(root) gid=0(root) groups=0(root)\r\n"]
[11.375565, "o", "\r\n\u001b[2m  # Read our effective Linux capabilities from /proc\u001b[0m\r\n\r\n"]
